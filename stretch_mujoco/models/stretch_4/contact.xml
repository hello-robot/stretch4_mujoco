<mujoco model="stretch contact">
  <contact>
    <!-- <exclude body1="link_head_pan" body2="link_head"/> -->

    <!-- References https://ekumenlabs.com/blog/posts/modeling-lekiwis-omni-base-in-mujoco/ -->
    <pair geom1="floor" geom2="link_back_wheel" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="link_left_wheel" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="link_right_wheel" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="base_link_collision" condim="3" friction="0.0 0.0" />


    <exclude body1="link_left_wheel" body2="base_link" />
    <exclude body1="link_right_wheel" body2="base_link" />
    <exclude body1="link_back_wheel" body2="base_link" />
    <exclude body1="base_link" body2="link_mast" />
    <exclude body1="link_lift" body2="link_mast" />
    <!-- <exclude body1="link_lift" body2="link_head"/> -->
    <exclude body1="link_arm_l0" body2="link_arm_l1" />
    <exclude body1="link_arm_l0" body2="link_arm_l2" />
    <exclude body1="link_arm_l0" body2="link_arm_l3" />
    <exclude body1="link_arm_l0" body2="link_lift" />
    <exclude body1="link_arm_l1" body2="link_arm_l3" />
    <exclude body1="link_arm_l1" body2="link_lift" />
    <exclude body1="link_arm_l2" body2="link_lift" />
    <exclude body1="link_arm_l2" body2="link_arm_l3" />
    <exclude body1="link_arm_l3" body2="link_lift" />
    <exclude body1="link_wrist_yaw" body2="link_arm_l0" />
    <exclude body1="link_wrist_yaw" body2="link_arm_l1" />
    <exclude body1="link_wrist_yaw" body2="link_arm_l2" />
    <exclude body1="link_wrist_yaw" body2="link_arm_l3" />
    <exclude body1="link_wrist_yaw" body2="link_arm_l4" />
    <exclude body1="link_arm_l1" body2="link_arm_l4" />
    <exclude body1="link_arm_l2" body2="link_arm_l4" />
    <exclude body1="link_arm_l3" body2="link_arm_l4" />
    <exclude body1="link_arm_l0" body2="link_arm_l4" />
    <exclude body1="link_gripper_finger_left" body2="link_wrist_pitch" />
    <exclude body1="link_gripper_finger_right" body2="link_wrist_pitch" />
    <exclude body1="link_gripper_finger_left" body2="link_wrist_yaw" />
    <exclude body1="link_gripper_finger_right" body2="link_wrist_yaw" />
    <exclude body1="link_gripper_finger_left" body2="link_grasp_center" />
    <exclude body1="link_gripper_finger_right" body2="link_grasp_center" />
    <exclude body1="link_gripper_finger_left" body2="link_gripper_finger_right" />
    <exclude body1="link_gripper_fingertip_left" body2="link_gripper_fingertip_right" />
    <exclude body1="link_gripper_fingertip_left" body2="link_gripper_finger_right" />
    <exclude body1="link_gripper_fingertip_right" body2="link_gripper_finger_left" />
    <exclude body1="link_aruco_fingertip_left" body2="link_aruco_fingertip_right" />
    <exclude body1="link_aruco_fingertip_left" body2="link_gripper_finger_right" />
    <exclude body1="link_aruco_fingertip_right" body2="link_gripper_finger_left" />
    <exclude body1="link_aruco_fingertip_left" body2="link_gripper_fingertip_right" />
    <exclude body1="link_aruco_fingertip_right" body2="link_gripper_fingertip_left" />
  </contact>

  <tendon>
    <fixed name="extend">
      <joint joint="joint_arm_l0" coef="1" />
      <joint joint="joint_arm_l1" coef="1" />
      <joint joint="joint_arm_l2" coef="1" />
      <joint joint="joint_arm_l3" coef="1" />
    </fixed>
  </tendon>

  <equality>
    <joint joint1="joint_arm_l0" joint2="joint_arm_l1" />
    <joint joint1="joint_arm_l1" joint2="joint_arm_l2" />
    <joint joint1="joint_arm_l2" joint2="joint_arm_l3" />
    <!-- <joint joint1="joint_gripper_finger_left" joint2="joint_gripper_slide" polycoef="0 10
    0 0 0" solref="0.005 1"/>
    <joint joint1="joint_gripper_finger_right" joint2="joint_gripper_slide" polycoef="0 10 0 0 0"
    solref="0.005 1"/> -->

  </equality>
</mujoco>
