<mujoco model="defaults">
  <option integrator="implicitfast" impratio="20" cone="elliptic">
    <flag multiccd="enable" />
  </option>
  <size njmax="5000" nconmax="5000" />

  <compiler angle="radian" />

  <default>
    <default class="stretch">
      <geom mass="0" solref="0.005 1" />
      <general biastype="affine" />

      <default class="wheel">
        <joint axis="0 0 1" armature="0.01" damping="0.1" frictionloss="0" limited="false" />
        <velocity kv="1" gear="6" />
        <position kp="500" forcerange="-2.5 2.5"/>
      </default>
      <default class="lift">
        <joint type="slide" axis="0 0 1" damping="35" stiffness="0.03" armature="0.01"
          range="0.0 1.1" frictionloss="1.5" />
        <general ctrlrange="0.0 1.1" gainprm="400" biasprm="0 -200 -100" forcerange="-70 70" />
        <default class="lift_stretch4">
          <joint type="slide" axis="0 0 1" damping="35" stiffness="0.03" armature="0.01"
            range="0.0 1.21" frictionloss="1.5" />
          <general ctrlrange="0.0 1.21" gainprm="400" biasprm="0 -200 -100" forcerange="-70 70" />
        </default>
      </default>
      <default class="telescope">
        <joint type="slide" axis="0 0 1" damping="50" stiffness="0.02" armature="0.01"
          range="0 0.13" frictionloss="1.5" />
        <general ctrlrange="0 0.52" gainprm="150" biasprm="0 -100 -10" forcerange="-56 56" />
      </default>
      <default class="head">
        <joint axis="0 0 1" damping="1" />
        <position kp="10" />
        <default class="head_pan">
          <joint range="-4.04 1.73" />
          <position ctrlrange="-4.04 1.73" />
        </default>
        <default class="head_tilt">
          <joint range="-1.53 0.79" />
          <position ctrlrange="-1.53 0.79" />
        </default>
      </default>

      <default class="wrist">
        <joint axis="0 0 1" damping="1" />
        <position kp="10" />
        <default class="wrist_yaw">
          <joint axis="0 0 -1" range="-3.4907 1.7453" armature="0.01" damping="7" frictionloss=".1" />
          <position ctrlrange="-3.4907 1.7453" kp="20" />
          <default class="wrist_yaw_stretch4">
            <joint axis="0 0 1" range="-1.134 4.28" armature="0.01" damping="7" frictionloss=".1" />
            <position ctrlrange="-1.134 4.28" kp="20" />
          </default>
        </default>
        <default class="wrist_pitch">
          <joint axis="0 0 1" range="-1.5708 2.618" armature="0.01" frictionloss=".1" />
          <position ctrlrange="-1.5708 2.618" kp="50" />
          <default class="wrist_pitch_stretch4">
            <joint axis="0 0 1" range="-1.134 4.28" armature="0.01" frictionloss=".1" />
            <position ctrlrange="-1.134 4.28" kp="50" />
          </default>
        </default>
        <default class="wrist_roll">
          <joint axis="0 0 1" range="-2.618 2.618" armature="0.01" frictionloss=".1" />
          <position ctrlrange="-2.618 2.618" kp="20" />
          <default class="wrist_roll_stretch4">
            <joint axis="0 0 1" range="-4.28 1.134" armature="0.01" frictionloss=".1" />
            <position ctrlrange="-4.28 1.134" kp="20" />
          </default>
        </default>
        <default class="finger_open">
          <default class="gripper_right_finger">
            <joint axis="0 1 0" range="0.0 0.5" damping="0.0001" armature="0.1" frictionloss=".1" />
            <position ctrlrange="0.0 0.5" kp="4000" kv="124"/>
          </default>
          <default class="gripper_left_finger">
            <joint axis="0 -1 0" range="0.0 0.5" damping="0.0001" armature="0.1" frictionloss=".1" />
            <position ctrlrange="0.0 0.5"  kp="4000" kv="124"/>
          </default>
        </default>
      </default>

      <default class="visualgeom">
        <geom group="2" type="mesh" contype="0" conaffinity="0" />
      </default>

      <default class="collision">
        <geom group="3" type="mesh" />
        <default class="rubber">
          <geom condim="6" friction="2 0.02 0.1" priority="1" solref="0.02 1"
            solimp="0.99 0.99 0.01" contype="1" conaffinity="1" />
        </default>

        <default class="omniwheel_collision">
            <geom type="capsule" size="0.1 0.01" pos="0 0 0" euler="0 0 0"
                  friction="0.8 0.05 0.001" contype="6" conaffinity="4"/>
        </default>
      </default>
    </default>
  </default>

</mujoco>
