  <tendon>
    <fixed name="extend">
      <joint joint="arm_l4_joint" coef="1" />
      <joint joint="arm_l3_joint" coef="1" />
      <joint joint="arm_l2_joint" coef="1" />
      <joint joint="arm_l1_joint" coef="1" />
    </fixed>
  </tendon>

  <equality>
    <joint joint1="arm_l4_joint" joint2="arm_l3_joint" />
    <joint joint1="arm_l3_joint" joint2="arm_l2_joint" />
    <joint joint1="arm_l2_joint" joint2="arm_l1_joint" />
    <!-- <joint joint1="gripper_finger_left_joint" joint2="gripper_slide_joint" polycoef="0 10
    0 0 0" solref="0.005 1"/>
    <joint joint1="gripper_finger_right_joint" joint2="gripper_slide_joint" polycoef="0 10 0 0 0"
    solref="0.005 1"/> -->

  </equality>
</mujoco>
