    <exclude body1="gripper_finger_right_link" body2="base_link" />
    <exclude body1="gripper_fingertip_left_link" body2="base_link" />
    <exclude body1="gripper_fingertip_right_link" body2="base_link" />
    
    <exclude body1="wrist_link" body2="docking_contact_link" />
    <exclude body1="wrist_yaw_link" body2="docking_contact_link" />
    <exclude body1="wrist_pitch_link" body2="docking_contact_link" />
