<mujoco model="stretch contact">
  <contact>
    <!-- <exclude body1="head_pan_link" body2="head_link"/> -->

    <!-- References https://ekumenlabs.com/blog/posts/modeling-lekiwis-omni-base-in-mujoco/ -->
    <pair geom1="floor" geom2="back_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="left_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="right_wheel_link" condim="3" friction="0.001 1.0" solref="0.005 1"
      solimp="0.9 0.95 0.001" />
    <pair geom1="floor" geom2="base_link_collision" condim="3" friction="0.0 0.0" />


    <exclude body1="left_wheel_link" body2="base_link" />
    <exclude body1="right_wheel_link" body2="base_link" />
    <exclude body1="back_wheel_link" body2="base_link" />
    <exclude body1="base_link" body2="mast_link" />
    <exclude body1="lift_link" body2="mast_link" />
    <!-- <exclude body1="lift_link" body2="head_link"/> -->
    
